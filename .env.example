# Platform settings — what the host sets. Copy to .env locally.
#
# Nothing here belongs to a user. Each user's Gmail app password and AI
# keys are entered in the app after signing in and stored encrypted on
# their profile (src/credentials.js, src/llm.js); there is no fallback
# to this file, on purpose.

# ---- Database ----
# Local docker: postgres://jobbjakt:jobbjakt@localhost:5433/jobbjakt
# Supabase: the SESSION pooler (port 5432), not the transaction pooler —
# the worker's advisory locks need a session. The direct connection is
# IPv6-only.
DATABASE_URL=postgres://jobbjakt:jobbjakt@localhost:5433/jobbjakt
# Supabase's CA certificate (Database → Settings → SSL Configuration),
# as PEM text — the connection then verifies the server. With it set,
# leave sslmode out of DATABASE_URL.
# DATABASE_CA_CERT=
# Connections per process. Keep it small on Vercel (3): every function
# instance has its own pool against the pooler's few dozen slots.
# PG_POOL_MAX=10

# ---- Encryption of users' stored passwords and keys ----
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored password/key unreadable (users re-enter them).
ENCRYPTION_KEY=

# ---- Login: set ONE of the two, or neither (src/authMode.js) ----
# Hosted app: Google login through Supabase Auth.
#   SUPABASE_URL / SUPABASE_ANON_KEY: Project Settings → API (the anon or
#   publishable key is public by design; RLS keeps it out of every table).
#   SUPABASE_SERVICE_ROLE_KEY: server only — deleting an account's login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local only: also offer an email link on /login (for a local Supabase
# without a Google client; the mail lands in Mailpit, localhost:55324).
# SUPABASE_EPOSTLANK=1
#
# Local password accounts instead (CI, testing several users without
# Supabase): any long random string.
# AUTH_SECRET=
#
# Neither: no login, one person on their own machine. Refused in
# production unless JOBBFLO_UTAN_INLOGGNING=1.

# ---- Ad pool (paid by the operator, not by users) ----
# Embeddings of the shared ad pool. Give this key its own credit limit
# on openrouter.ai — it is the only spend the platform carries.
PLATFORM_OPENROUTER_API_KEY=
# EMBED_PROVIDER=openrouter        # or: openai, local (LM Studio)
# EMBED_MODEL=openai/text-embedding-3-small
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# JobStream (Arbetsförmedlingen) needs a free key from jobtechdev.se.
JOBSTREAM_API_KEY=

# ---- Janitor pacing (optional) ----
# JANITOR_SNAPSHOT_HOURS=24
# JANITOR_SWEEP_HOURS=6
