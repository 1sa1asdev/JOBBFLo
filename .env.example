# Copy to .env and fill in. The worker and the Next.js app both read this.

# Postgres — Neon/Supabase connection string, or local docker (see README)
DATABASE_URL=postgres://jobbjakt:jobbjakt@localhost:5432/jobbjakt

# AI — scoring, letters, classification. Set ONE of these:
# OpenRouter (free models, free account at openrouter.ai/keys) — preferred for testing
OPENROUTER_API_KEY=
# override the default free models if one gets deprecated/rate-limited
# (list current ones: curl -s https://openrouter.ai/api/v1/models | grep ':free'):
# OPENROUTER_MODEL_SMART=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_FAST=nvidia/nemotron-nano-9b-v2:free
# ...or Anthropic direct (paid)
ANTHROPIC_API_KEY=

# Gmail — outgoing mail (app password, not your real password:
# https://myaccount.google.com/apppasswords) and incoming via IMAP IDLE
GMAIL_USER=din@gmail.com
GMAIL_APP_PASSWORD=

# JobStream requires a free API key from jobtechdev.se for the /stream endpoint.
# JobSearch (backfill) works without one.
JOBSTREAM_API_KEY=

# REQUIRED when deployed publicly: puts the whole site behind a password
# (HTTP Basic Auth — any username, this password). Leave empty locally.
APP_PASSWORD=
